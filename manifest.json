{
  "manifest_version": 3,
  "name": "Focus Guard",
  "version": "1.0",
  "incognito": "spanning",
  "permissions": ["storage", "tabs", "alarms", "webNavigation"],
  "host_permissions": ["*://*.youtube.com/*", "*://*.instagram.com/*"],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "popup.html"
  }
}